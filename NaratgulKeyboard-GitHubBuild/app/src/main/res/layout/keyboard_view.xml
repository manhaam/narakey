<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F1F5F9"
    android:paddingTop="6dp"
    android:paddingBottom="10dp"
    android:paddingHorizontal="4dp">

    <!-- 1. 나랏글 한글 레이아웃 (LG 순정 배열) -->
    <LinearLayout
        android:id="@+id/layoutKorean"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- 1행: ㄱ | ㄴ | ㅏ ㅓ | 지우기 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/k_g" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㄱ" android:textSize="20sp" android:textColor="#0F172A" />
            <Button android:id="@+id/k_n" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㄴ" android:textSize="20sp" android:textColor="#0F172A" />
            <Button android:id="@+id/k_aeo" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㅏ ㅓ" android:textSize="19sp" android:textColor="#0F172A" />
            <Button android:id="@+id/k_del" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.9" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="⌫" android:textSize="20sp" android:textColor="#334155" />
        </LinearLayout>

        <!-- 2행: ㄹ | ㅁ | ㅗ ㅜ | 엔터 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/k_r" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㄹ" android:textSize="20sp" android:textColor="#0F172A" />
            <Button android:id="@+id/k_m" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㅁ" android:textSize="20sp" android:textColor="#0F172A" />
            <Button android:id="@+id/k_ou" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㅗ ㅜ" android:textSize="19sp" android:textColor="#0F172A" />
            <Button android:id="@+id/k_enter" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.9" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="↵" android:textSize="20sp" android:textColor="#334155" />
        </LinearLayout>

        <!-- 3행: ㅅ | ㅇ | ㅣ | . , ? ! -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/k_s" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㅅ" android:textSize="20sp" android:textColor="#0F172A" />
            <Button android:id="@+id/k_ng" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㅇ" android:textSize="20sp" android:textColor="#0F172A" />
            <Button android:id="@+id/k_i" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㅣ" android:textSize="20sp" android:textColor="#0F172A" />
            <Button android:id="@+id/k_punc" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.9" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text=".,?!" android:textSize="15sp" android:textColor="#334155" />
        </LinearLayout>

        <!-- 4행: 획추가 | 쌍자음 | ㅡ | 띄어쓰기 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/k_stroke" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="획추가" android:textSize="15sp" android:textStyle="bold" android:textColor="#1E293B" />
            <Button android:id="@+id/k_double" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="쌍자음" android:textSize="15sp" android:textStyle="bold" android:textColor="#1E293B" />
            <Button android:id="@+id/k_eu" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㅡ" android:textSize="20sp" android:textColor="#0F172A" />
            <Button android:id="@+id/k_space" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.9" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="공백" android:textSize="15sp" android:textColor="#334155" />
        </LinearLayout>

        <!-- 5행 하단 전환 바: 한/영 | !#1 | 쉼표 | 마침표 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:orientation="horizontal">
            <Button android:id="@+id/k_to_en" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="한/영" android:textSize="14sp" android:textStyle="bold" android:textColor="#0F172A" />
            <Button android:id="@+id/k_to_sym" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="!#1" android:textSize="14sp" android:textColor="#334155" />
            <Button android:id="@+id/k_comma" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.75" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="," android:textSize="18sp" android:textColor="#0F172A" />
            <Button android:id="@+id/k_dot" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.75" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="." android:textSize="18sp" android:textColor="#0F172A" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. 영문 QWERTY 레이아웃 -->
    <LinearLayout
        android:id="@+id/layoutEnglish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout android:id="@+id/enRow1" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp" />
        <LinearLayout android:id="@+id/enRow2" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp" android:paddingHorizontal="14dp" />
        <LinearLayout android:id="@+id/enRow3" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
            <Button android:id="@+id/en_to_ko" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.4" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="한/영" android:textSize="14sp" android:textStyle="bold" />
            <Button android:id="@+id/en_to_sym" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="!#1" android:textSize="14sp" />
            <Button android:id="@+id/en_space" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3.6" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="English" android:textSize="15sp" />
            <Button android:id="@+id/en_dot" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="." android:textSize="18sp" />
            <Button android:id="@+id/en_enter" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="↵" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. 특수문자 레이아웃 -->
    <LinearLayout
        android:id="@+id/layoutSymbol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout android:id="@+id/symRow1" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp" />
        <LinearLayout android:id="@+id/symRow2" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp" />
        <LinearLayout android:id="@+id/symRow3" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
            <Button android:id="@+id/sym_to_ko" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="가나다" android:textSize="14sp" android:textStyle="bold" />
            <Button android:id="@+id/sym_to_en" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="ABC" android:textSize="14sp" />
            <Button android:id="@+id/sym_space" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3.6" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="공백" android:textSize="15sp" />
            <Button android:id="@+id/sym_enter" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="↵" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
