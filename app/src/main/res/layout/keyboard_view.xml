<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#202225"
    android:paddingTop="6dp"
    android:paddingBottom="10dp"
    android:paddingHorizontal="3dp">

    <!-- 1. LG 순정 스타일 나랏글 한글 레이아웃 -->
    <LinearLayout
        android:id="@+id/layoutKorean"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- 최상단 숫자 행: 1 2 3 4 5 6 7 8 9 0 -->
        <LinearLayout android:id="@+id/koNumRow" android:layout_width="match_parent" android:layout_height="38dp" android:orientation="horizontal" android:layout_marginBottom="4dp" />

        <!-- 1행: ? | ㄱ | ㄴ | ㅏ ㅓ | ⌫ -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/k_qmark" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.85" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="?" android:textSize="18sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_g" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㄱ" android:textSize="21sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_n" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㄴ" android:textSize="21sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_aeo" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㅏ ㅓ" android:textSize="19sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_del" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.85" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="⌫" android:textSize="19sp" android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 2행: 123 | ㄹ | ㅁ | ㅗ ㅜ | ↵ -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/k_123" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.85" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="123" android:textSize="15sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_r" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㄹ" android:textSize="21sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_m" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㅁ" android:textSize="21sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_ou" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㅗ ㅜ" android:textSize="19sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_enter" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.85" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="↵" android:textSize="20sp" android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 3행: 한/영 | ㅅ | ㅇ | ㅣ | ! -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/k_to_en" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.85" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="한/영" android:textSize="14sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_s" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㅅ" android:textSize="21sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_ng" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㅇ" android:textSize="21sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_i" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㅣ" android:textSize="21sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_exclam" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.85" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="!" android:textSize="18sp" android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 4행: !#1 | 획추가 | ㅡ | 쌍자음 | 공백 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
            <Button android:id="@+id/k_to_sym" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.85" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="!#1" android:textSize="14sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_stroke" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="획추가" android:textSize="15sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_eu" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="ㅡ" android:textSize="21sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_double" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="쌍자음" android:textSize="15sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/k_space" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.85" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="공백" android:textSize="15sp" android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. 영문 QWERTY 레이아웃 (다크 테마 + 상단 숫자행) -->
    <LinearLayout
        android:id="@+id/layoutEnglish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout android:id="@+id/enNumRow" android:layout_width="match_parent" android:layout_height="38dp" android:orientation="horizontal" android:layout_marginBottom="4dp" />
        <LinearLayout android:id="@+id/enRow1" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp" />
        <LinearLayout android:id="@+id/enRow2" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp" android:paddingHorizontal="14dp" />
        <LinearLayout android:id="@+id/enRow3" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
            <Button android:id="@+id/en_to_ko" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.4" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="한/영" android:textSize="14sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/en_to_sym" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="!#1" android:textSize="14sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/en_space" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3.6" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="English" android:textSize="15sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/en_dot" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="." android:textSize="18sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/en_enter" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="↵" android:textSize="18sp" android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. 특수문자 레이아웃 (다크 테마) -->
    <LinearLayout
        android:id="@+id/layoutSymbol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout android:id="@+id/symRow1" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp" />
        <LinearLayout android:id="@+id/symRow2" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp" />
        <LinearLayout android:id="@+id/symRow3" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginBottom="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
            <Button android:id="@+id/sym_to_ko" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="가나다" android:textSize="14sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/sym_to_en" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="ABC" android:textSize="14sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/sym_space" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3.6" android:layout_margin="2dp" android:background="@drawable/key_bg" android:text="공백" android:textSize="15sp" android:textColor="#FFFFFF" />
            <Button android:id="@+id/sym_enter" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:layout_margin="2dp" android:background="@drawable/key_func_bg" android:text="↵" android:textSize="18sp" android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
